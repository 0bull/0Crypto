---
import Landing from "../layouts/Landing.astro";
import Hero from "../components/landing/Hero.astro";
import Trail from "../components/Trail.astro";
import Features from "../components/landing/Features.astro";
import Coins from "../components/landing/Coins.astro";
import HowSetup from "../components/landing/HowSetup.astro";
import Privacy from "../components/landing/Privacy.astro";
import Faq from "../components/landing/Faq.astro";
import Footer from "../components/landing/Footer.astro";
---

<Landing
  title="0Crypto: crypto payments in your own Cloudflare account"
  description="A self-hosted crypto payment gateway that runs in your own Cloudflare account. Watch-only wallets, passkey sign-in, no middleman fee."
>
  <Hero />
  <main id="main">
    <section class="section section--trail" aria-labelledby="trail-title">
      <div class="wrap">
        <h2 id="trail-title" class="section__title">The trail stops before it reaches you.</h2>
      </div>
      <div class="trail-band">
        <Trail />
      </div>
    </section>
    <Features />
    <Coins />
    <HowSetup />
    <Privacy />
    <Faq />
  </main>
  <Footer />
</Landing>
