---
import { DOCS_PATH } from "../../site.config.ts";

// Below 640 px the table restyles into one stacked card per row (landing.css). Changing a
// table's display drops its semantics in some browsers, so the roles are stated explicitly.
const rows = [
  { coin: "BTC", network: "Bitcoin", mode: "watch", how: "Your wallet's xpub or zpub. Payments land in your wallet." },
  { coin: "LTC", network: "Litecoin", mode: "watch", how: "Your wallet's Ltub. Payments land in your wallet." },
  { coin: "DOGE", network: "Dogecoin", mode: "watch", how: "Your wallet's dgub. Payments land in your wallet." },
  {
    coin: "BTC (Lightning)",
    network: "Lightning",
    mode: "lightning",
    how: "Nostr Wallet Connect to a wallet you already run. Receive-only; funds stay in your wallet.",
  },
  {
    coin: "ETH, USDC, USDT, DAI",
    network: "Ethereum, Base, Arbitrum, Polygon, BNB Chain",
    mode: "routed",
    how: "Swept to a hot wallet per chain. The native coin is POL on Polygon and BNB on BNB Chain; Base has no USDT.",
  },
  {
    coin: "USDT",
    network: "Tron",
    mode: "routed",
    how: "Swept to a hot wallet on Tron. TRX sent to a deposit address is not recovered.",
  },
  { coin: "SOL, USDC", network: "Solana", mode: "routed", how: "Swept to a hot wallet on Solana." },
] as const;

const modes = {
  watch: "Watch",
  routed: "Routed",
  lightning: "Lightning",
} as const;
---

<section id="coins" class="section" aria-labelledby="coins-title">
  <div class="wrap">
    <h2 id="coins-title" class="section__title">Coins and networks</h2>
    <p class="section__lede">
      Watch mode holds no key that can spend: the Worker only watches addresses from your wallet's public key. Routed mode
      derives addresses from a seed phrase stored in your Worker, so it can sweep funds and route them privately.
    </p>

    <table class="coins" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <th scope="col" role="columnheader">Coin</th>
          <th scope="col" role="columnheader">Network</th>
          <th scope="col" role="columnheader">How it works</th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          rows.map(({ coin, network, mode, how }) => (
            <tr role="row">
              <th scope="row" role="rowheader" class="coins__coin">
                {coin}
              </th>
              <td role="cell" class="coins__network" data-label="Network">
                {network}
              </td>
              <td role="cell" class="coins__how" data-label="How it works">
                <span class:list={["mode", `mode--${mode}`]}>{modes[mode]}</span>
                <span class="coins__note">{how}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="note">
      <svg class="note__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
        <path d="M12 11v5.5M12 7.5h.01" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"
        ></path>
      </svg>
      <span>
        Routed mode holds the keys in your Worker, so anyone who takes over the Worker or the seed phrase can move
        swept funds. <a href={`${DOCS_PATH}advanced/routed-mode/`}>Read about routed mode</a> before you turn it on.
      </span>
    </p>
  </div>
</section>
