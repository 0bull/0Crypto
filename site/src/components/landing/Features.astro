---
// Six things you get, one plain sentence each. Icons are 24-unit strokes drawn with
// presentation attributes only (the CSP allows no style= of ours).
const features = [
  {
    title: "Your own Cloudflare account",
    text: "It runs as a Worker in your own account with no middleman and no 0Crypto fee; you pay Cloudflare's plan, plus network and swap costs if you turn on routed mode.",
    icon: ["M7 18h10.5a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.6 8.6 4.75 4.75 0 0 0 7 18Z"],
  },
  {
    title: "Watch-only wallets",
    text: "For BTC, LTC and DOGE you paste your wallet's public key, payments land in your wallet, and the Worker cannot spend them.",
    icon: ["M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z", "M12 9.25a2.75 2.75 0 1 0 0 5.5 2.75 2.75 0 0 0 0-5.5Z"],
  },
  {
    title: "Passkey sign-in",
    text: "You sign in to the dashboard with a passkey on your phone or laptop, so there is no password to steal.",
    icon: ["M8 14.5a4.5 4.5 0 1 1 3.9-6.75H21v3h-2v2.5h-2.5v-2.5h-4.6A4.5 4.5 0 0 1 8 14.5Z", "M7 10h.01"],
  },
  {
    title: "Connects to your shop",
    text: "Signed webhooks, a WooCommerce plugin, payment links and an API fit it to the shop you already run.",
    icon: ["M9 7 4 12l5 5", "m15 7 5 5-5 5"],
  },
  {
    title: "Point of sale and recurring invoices",
    text: "Take a payment at the counter from a tablet, or send an invoice that repeats on a schedule.",
    icon: ["M4 5.5h16v10H4z", "M9 19.5h6", "M12 15.5v4"],
  },
  {
    title: "Optional privacy routing",
    text: "In routed mode, received funds can move through Railgun or a swap to Monero before they reach your own wallet.",
    icon: ["M4 7h4l3 5 3 5h6", "M4 17h4l1.8-3", "M14.2 10 16 7h4", "m18 5 2 2-2 2", "m18 15 2 2-2 2"],
  },
];
---

<section id="features" class="section" aria-labelledby="features-title">
  <div class="wrap">
    <h2 id="features-title" class="section__title">What you get</h2>
    <ul class="cards">
      {
        features.map(({ title, text, icon }) => (
          <li class="card">
            <svg class="card__icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
              {icon.map((d) => (
                <path
                  d={d}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              ))}
            </svg>
            <h3 class="card__title">{title}</h3>
            <p class="card__text">{text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
