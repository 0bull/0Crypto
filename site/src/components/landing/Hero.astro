---
import { DEPLOY_URL, DOCS_PATH, REPO_URL } from "../../site.config.ts";

const coins = ["BTC", "Lightning", "LTC", "DOGE", "ETH", "USDC", "USDT", "DAI", "SOL", "TRON"];
---

<header id="top" class="hero">
  <nav class="nav wrap" aria-label="Main">
    <a class="wordmark" href="/" aria-label="0Crypto home">0Crypto</a>
    <ul class="nav__links">
      <li><a href={DOCS_PATH}>Docs</a></li>
      <li><a href={REPO_URL}>GitHub</a></li>
    </ul>
  </nav>

  <div class="hero__body wrap">
    <h1 class="hero__title">
      <span class="hero__line">Your money.</span>
      <span class="hero__line hero__line--red">Nobody's business.</span>
    </h1>

    <div class="hero__foot">
      <p class="hero__sub">
        Crypto payments that run in your own Cloudflare account. Set up in two minutes. Customers see their payment,
        not your balance.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href={DEPLOY_URL}>
          <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path
              d="M7 18.5h10.5a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.6 9.1 4.75 4.75 0 0 0 7 18.5Z"
              fill="currentColor"
              fill-opacity="0.22"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linejoin="round"></path>
          </svg>
          Deploy to Cloudflare
        </a>
        <a class="btn btn--ghost" href={DOCS_PATH}>Read the docs</a>
      </div>
    </div>

    <ul id="coin-row" class="coin-row" aria-label="Coins you can accept">
      {coins.map((coin) => <li>{coin}</li>)}
    </ul>
  </div>
</header>
