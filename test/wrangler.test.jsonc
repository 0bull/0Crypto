// Test-only copy of ../wrangler.jsonc. It lives here so the Workers test pool never loads a
// developer's local .dev.vars (wrangler reads it from the config's directory, and test/ has none).
// Keep bindings in sync with ../wrangler.jsonc; test/node/wrangler-config.test.ts checks this.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "0crypto",
  "main": "../src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "0crypto", "database_id": "local-0crypto-db", "migrations_dir": "../migrations" }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "local-0crypto-kv" }],
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "0crypto-webhooks" }],
    "consumers": [
      { "queue": "0crypto-webhooks", "dead_letter_queue": "0crypto-webhooks-dlq", "max_retries": 20 },
      { "queue": "0crypto-webhooks-dlq", "max_retries": 5 }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "WATCHER", "class_name": "PaymentWatcher" }]
  },
  "exports": {
    "PaymentWatcher": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": { "directory": "../public", "binding": "ASSETS", "run_worker_first": ["/", "/healthz", "/admin", "/admin/*", "/api/*", "/pos", "/pos/*", "/i/*", "/l/*"] },
  // Test values. Every var in ../wrangler.jsonc is listed so nothing falls back to a local file, plus the optional
  // EVM_RPC_*, Tron, Solana, Trocador and NWC secrets (not vars in ../wrangler.jsonc: their URLs carry API keys), bound empty; tests set them per file.
  "vars": {
    "PUBLIC_URL": "https://pay.test",
    "ENABLED_ASSETS": "btc:btc,ltc:ltc",
    "MERCHANT_NAME": "",
    "WEBHOOK_URL": "",
    "DOGE_BLOCKBOOK_URL": "",
    "RAILGUN_0ZK_ADDRESS": "",
    "RAILGUN_GOLDEN_OK": "",
    "RAILGUN_GOLDEN_OK_CHAINS": "",
    "XMR_ADDRESS": "",
    "TROCADOR_LIVE_OK": "",
    "TROCADOR_MIN_KYC": "A",
    "ROUTE_MIN_BATCH_USD": "200",
    "ROUTE_DELAY_MIN_H": "2",
    "ROUTE_DELAY_MAX_H": "24",
    "HOT_CAP_USD": "5000",
    "EVM_RPC_ETH": "",
    "EVM_RPC_BASE": "",
    "EVM_RPC_ARB": "",
    "EVM_RPC_POLYGON": "",
    "EVM_RPC_BSC": "",
    "TRONGRID_API_KEY": "",
    "TRON_API_URL": "",
    "TRONSAVE_API_KEY": "",
    "SOLANA_RPC_URL": "",
    "TROCADOR_API_KEY": "",
    "NWC_URI": ""
  },
  // No "secrets" block: vitest.config.ts binds test secrets directly (avoids a missing-secrets warning).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 } },
  "upload_source_maps": true,
  "minify": true,
  "triggers": { "crons": ["* * * * *", "*/15 * * * *", "5-59/15 * * * *", "0 * * * *", "30 * * * *"] },
  "ratelimits": [
    { "name": "API_RATE", "namespace_id": "8317", "simple": { "limit": 60, "period": 60 } }
  ]
}
