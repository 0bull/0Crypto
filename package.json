{
  "name": "0crypto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "deploy:factory": "tsx scripts/deploy-factory.ts",
    "dev": "wrangler dev",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "typecheck": "tsc --noEmit && hardhat build --quiet && tsc --noEmit -p tsconfig.contracts.json && tsc --noEmit -p client/tsconfig.json",
    "build:passkey": "node scripts/build-passkey.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "types": "wrangler types --include-runtime false",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "deploy:first": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "contracts:test": "hardhat test nodejs",
    "test:woo": "cd plugins/woocommerce && composer install --no-interaction && vendor/bin/phpunit"
  },
  "cloudflare": {
    "bindings": {
      "ENABLED_ASSETS": {
        "description": "Leave as is. You choose this in the setup wizard."
      },
      "TROCADOR_MIN_KYC": {
        "description": "Leave as is unless you use privacy routing. See the docs."
      },
      "ROUTE_MIN_BATCH_USD": {
        "description": "Leave as is unless you use privacy routing. See the docs."
      },
      "ROUTE_DELAY_MIN_H": {
        "description": "Leave as is unless you use privacy routing. See the docs."
      },
      "ROUTE_DELAY_MAX_H": {
        "description": "Leave as is unless you use privacy routing. See the docs."
      },
      "HOT_CAP_USD": {
        "description": "Leave as is unless you use privacy routing. See the docs."
      }
    }
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@scure/btc-signer": "^2.4.1",
    "@simplewebauthn/server": "14.0.3",
    "@solana-program/system": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "hono": "^4.13.18",
    "nostr-tools": "2.25.4",
    "poseidon-lite": "0.3.0",
    "uqr": "^0.1.3",
    "viem": "^2.57.19"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@msw/cloudflare": "^0.2.0",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
    "@nomicfoundation/hardhat-viem": "^3.1.0",
    "@openzeppelin/contracts": "5.6.1",
    "@simplewebauthn/browser": "14.0.0",
    "bip32": "^5.0.1",
    "bip39": "^3.1.2",
    "bitcoinjs-lib": "^7.0.5",
    "ed25519-hd-key": "^2.0.0",
    "hardhat": "^3.22.0",
    "msw": "^3.0.5",
    "rolldown": "1.2.19",
    "tiny-secp256k1": "^2.2.5",
    "tronweb": "6.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "nostr-tools": {
      "@noble/curves": "$@noble/curves",
      "@noble/hashes": "$@noble/hashes",
      "@scure/base": "$@scure/base"
    }
  },
  "license": "MIT"
}
